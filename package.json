{
  "name": "recipeshare",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run db:migrate && npm run db:test && next build",
    "start": "next start",
    "db:migrate": "node scripts/migrate.mjs",
    "db:seed": "node db/seed.mjs",
    "db:test": "node scripts/db-test.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "@next/env": "^16.4.6",
    "@neondatabase/serverless": "^1.2.1",
    "next": "^16.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.1",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.15"
  }
}
